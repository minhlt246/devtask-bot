# Copy this file to `.env` and fill in real values.
# Never commit `.env` to Git.

# Required — from @BotFather
TELEGRAM_BOT_TOKEN=

# Required — numeric Telegram user IDs allowed to use the bot (comma-separated)
# Tip: message a trusted “user id” bot, or temporarily log update.effective_user.id
ALLOWED_TELEGRAM_USER_IDS=

# Optional — SQLite path (default: data/devtask.sqlite3)
DATABASE_PATH=data/devtask.sqlite3

# Optional — legacy projects JSON path (auto-discovery is used when PROJECT_SCAN_ROOT is unset)
PROJECTS_CONFIG_PATH=config/projects.json

# Optional — logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Optional — limit project scan to one directory.
# Leave unset/empty to scan Desktop, Documents, Downloads, and other common folders under $HOME.
# PROJECT_SCAN_ROOT=/absolute/path/to/your/code

# Optional — IDE name for /open (Cursor, code/VS Code, …)
# macOS: mapped to Application name via `open -a`
# Windows: uses editor CLI on PATH, else opens the folder in Explorer
CODE_EDITOR=Cursor

# Optional — Antigravity / agy CLI used by the worker
# Defaults (when unset):
#   macOS/Linux: ~/.local/bin/agy or PATH
#   Windows: %LOCALAPPDATA%\agy\bin\agy.exe or PATH
AGY_COMMAND=

# Optional — agent subprocess timeout in seconds (minimum enforced: 60; default: 1800)
AGENT_TIMEOUT_SECONDS=1800

# Optional — automatic test-run timeout in seconds (minimum enforced: 30; default: 300)
TEST_TIMEOUT_SECONDS=300

# Optional — AI Router policy: balanced, latency_first, reliability_first, cost_first (default: balanced)
AI_ROUTER_POLICY=balanced

# Optional — enable automatic fallback to next eligible provider if chosen provider fails (default: true)
AI_FALLBACK_ENABLED=true

# Optional — Multi-AI Provider API Keys (leave empty to use CLI or keep provider disabled)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# MUSE_API_KEY=
